Algoritmo "Linguagem de Programação I"

Var
   SUB,X,API,P1,E1,E2,EXF,R,R1,R2,R3: real

Inicio
   escreval("Calculadora de média")
   escreval("")
   escreva("Nota da prova 1: ")
   leia(P1)
   escreval("")
   escreva("Nota da entrega 1: ")
   leia(E1)
   escreval("")
   escreva("Nota da entrega 2: ")
   leia(E2)
   escreval("")
   escreva("Nota das atividades extras: ")
   leia(X)
   escreval("")
   escreva("Nota da prova substitutiva: ")
   leia(SUB)
   escreval("")
   escreva("Nota da API: ")
   leia(API)
   escreval("")
   escreva("Nota do exame final: ")
   leia(EXF)
   escreval("")

   limpatela
   R<-((P1*0.5)+(E1*0.2)+(E2*0.3)+X+(SUB*0.15))*0.5
   R1<-((P1*0.5)+(E1*0.2)+(E2*0.3)+X+(SUB*0.15))-5.9

   se (R1>0) entao
      R2<-(R1/R1)*API*0.5
      R3<-R2+R
      se (R3>EXF) entao
         escreval("A sua nota final foi: ", R3:2:2)
      senao
         escreval("A sua nota final foi: ", EXF:2:2)
      fimse
   senao
      escreval("Sua média foi abaixo do mínimo necessário :(")
fimse


Fimalgoritmo
